// Daz Forge - JCM Gate Repair
//
// Purpose:
//   Add one character body morph as a multiply/ERC gate for that same
//   character's JCM/CBS morphs on the selected figure.
//
// Usage:
//   1. Load the character in Daz Studio.
//   2. Select the figure in the Scene pane.
//   3. Leave CHARACTER_MATCH/JCM_MATCH blank to auto-detect the active
//      character morph, or set them manually if auto-detect is wrong.
//   4. Run once with APPLY_CHANGES = false and inspect the preview.
//   5. Set APPLY_CHANGES = true, run again, then use:
//      File > Save As > Support Asset > Save Modified Assets
//      Select only the changed character morph assets.

var CHARACTER_MATCH = "";
var JCM_MATCH = "";
var AUTO_DETECT_ACTIVE_CHARACTER = true;
var APPLY_CHANGES = false;
var ALLOW_FALLBACK_GATE = false;
var MAX_PREVIEW_LINES = 80;
var MAX_DIAGNOSTIC_LINES = 25;

function textOf( value ) {
	if( value == undefined || value == null ){
		return "";
	}

	return String( value );
}

function lower( value ) {
	return textOf( value ).toLowerCase();
}

function propertyName( prop ) {
	var names = [];

	try {
		names.push( textOf( prop.name ) );
	} catch( e1 ) {}

	try {
		names.push( textOf( prop.getName() ) );
	} catch( e2 ) {}

	try {
		names.push( textOf( prop.getLabel() ) );
	} catch( e3 ) {}

	try {
		names.push( textOf( prop.label ) );
	} catch( e4 ) {}

	try {
		names.push( textOf( prop.getPath() ) );
	} catch( e5 ) {}

	try {
		names.push( textOf( prop.assetUri ) );
	} catch( e6 ) {}

	return names.join( " | " );
}

function displayName( prop ) {
	var label = "";
	var name = "";

	try {
		label = textOf( prop.getLabel() );
	} catch( e1 ) {}

	try {
		name = textOf( prop.getName() );
	} catch( e2 ) {}

	if( label.length > 0 ){
		return label;
	}

	if( name.length > 0 ){
		return name;
	}

	return propertyName( prop );
}

function isNumericProperty( prop ) {
	if( !prop ){
		return false;
	}

	try {
		return prop.inherits( "DzNumericProperty" );
	} catch( e ) {
		return false;
	}
}

function getAllProperties( element ) {
	try {
		return element.getPropertyList();
	} catch( e ) {
		return [];
	}
}

function getPropertyAt( list, index ) {
	try {
		if( list.at ){
			return list.at( index );
		}
	} catch( e1 ) {}

	try {
		return list[index];
	} catch( e2 ) {
		return null;
	}
}

function getListLength( list ) {
	try {
		if( list.length != undefined ){
			return list.length;
		}
	} catch( e1 ) {}

	try {
		if( list.count ){
			return list.count();
		}
	} catch( e2 ) {}

	try {
		if( list.size ){
			return list.size();
		}
	} catch( e3 ) {}

	return 0;
}

function looksLikeCharacterBody( prop, matchText ) {
	var haystack = lower( propertyName( prop ) );
	var needle = lower( matchText );

	if( needle.length > 0 && haystack.indexOf( needle ) < 0 ){
		return false;
	}

	return (
		haystack.indexOf( "body" ) >= 0 ||
		haystack.indexOf( "character" ) >= 0 ||
		haystack.indexOf( "actor" ) >= 0
	);
}

function isGenericGateProperty( prop ) {
	var name = lower( propertyName( prop ) );

	return (
		name.indexOf( "base joint" ) >= 0 ||
		name.indexOf( "joint corrective" ) >= 0 ||
		name.indexOf( "joint correctives" ) >= 0 ||
		name.indexOf( "base corrective" ) >= 0 ||
		name.indexOf( "base pose" ) >= 0 ||
		name.indexOf( "base flexion" ) >= 0 ||
		name.indexOf( "genesis 9 base" ) >= 0 ||
		name.indexOf( "genesis9 base" ) >= 0
	);
}

function getNumericValue( prop ) {
	try {
		return prop.getValueAsDouble();
	} catch( e1 ) {}

	try {
		return prop.getDoubleValue();
	} catch( e2 ) {}

	try {
		return prop.getValue();
	} catch( e3 ) {}

	return 0.0;
}

function isActiveProperty( prop ) {
	try {
		if( !prop.currentValueIsDefaultValue() ){
			return true;
		}
	} catch( e1 ) {}

	return Math.abs( getNumericValue( prop ) ) > 0.001;
}

function findActiveCharacterGateProperty( props ) {
	var best = null;
	var bestValue = 0.0;
	var count = getListLength( props );

	for( var i = 0; i < count; i++ ){
		var prop = getPropertyAt( props, i );

		if( !isNumericProperty( prop ) || !isActiveProperty( prop ) ){
			continue;
		}

		if( !looksLikeCharacterBody( prop, "" ) ){
			continue;
		}

		if( isGenericGateProperty( prop ) ){
			continue;
		}

		var name = lower( propertyName( prop ) );
		if( name.indexOf( "jcm" ) >= 0 || name.indexOf( "cbs" ) >= 0 ){
			continue;
		}

		var value = Math.abs( getNumericValue( prop ) );
		if( !best || value > bestValue ){
			best = prop;
			bestValue = value;
		}
	}

	return best;
}

function deriveMatchTextFromGate( gateProp ) {
	var text = displayName( gateProp );

	text = text.replace( /^FBM/i, "" );
	text = text.replace( /^PBM/i, "" );
	text = text.replace( /^CTRL/i, "" );
	text = text.replace( /Genesis\s*9/ig, "" );
	text = text.replace( /\bG9\b/ig, "" );
	text = text.replace( /\bBody\b/ig, "" );
	text = text.replace( /\bCharacter\b/ig, "" );
	text = text.replace( /\bActor\b/ig, "" );
	text = text.replace( /\bFemale\b/ig, "" );
	text = text.replace( /\bMale\b/ig, "" );
	text = text.replace( /\b\d+\b/g, "" );
	text = text.replace( /[_\-]+/g, " " );
	text = text.replace( /^\s+|\s+$/g, "" );

	if( text.length > 0 ){
		return text.split( /\s+/ )[0];
	}

	return displayName( gateProp );
}

function collectActiveCharacterDiagnostics( props, limit ) {
	var lines = [];
	var count = getListLength( props );

	for( var i = 0; i < count; i++ ){
		var prop = getPropertyAt( props, i );

		if( !isNumericProperty( prop ) || !isActiveProperty( prop ) ){
			continue;
		}

		if( !looksLikeCharacterBody( prop, "" ) ){
			continue;
		}

		var suffix = "";
		if( isGenericGateProperty( prop ) ){
			suffix = " [generic skipped]";
		}

		lines.push( "  - " + displayName( prop ) + " = " + getNumericValue( prop ) + suffix );

		if( lines.length >= limit ){
			break;
		}
	}

	return lines;
}

function looksLikeJcmOrCbs( prop, matchText ) {
	var haystack = lower( propertyName( prop ) );
	var needle = lower( matchText );

	if( haystack.indexOf( needle ) < 0 ){
		return false;
	}

	return (
		haystack.indexOf( "jcm" ) >= 0 ||
		haystack.indexOf( "cbs" ) >= 0 ||
		haystack.indexOf( "pjcm" ) >= 0 ||
		haystack.indexOf( "ejcm" ) >= 0 ||
		haystack.indexOf( "fbm" ) >= 0 && haystack.indexOf( "ctrl" ) >= 0
	);
}

function findGateProperty( props, matchText ) {
	var fallback = null;
	var count = getListLength( props );

	for( var i = 0; i < count; i++ ){
		var prop = getPropertyAt( props, i );

		if( !isNumericProperty( prop ) ){
			continue;
		}

		var haystack = lower( propertyName( prop ) );
		if( haystack.indexOf( lower( matchText ) ) < 0 ){
			continue;
		}

		if( !fallback ){
			fallback = prop;
		}

		if( looksLikeCharacterBody( prop, matchText ) ){
			return prop;
		}
	}

	if( ALLOW_FALLBACK_GATE ){
		return fallback;
	}

	return null;
}

function controllerUsesGate( controller, gateProp ) {
	if( !controller || !gateProp ){
		return false;
	}

	try {
		if( controller.getProperty && controller.getProperty() == gateProp ){
			return true;
		}
	} catch( e1 ) {}

	try {
		if( controller.getCurrentProperty && controller.getCurrentProperty() == gateProp ){
			return true;
		}
	} catch( e2 ) {}

	return false;
}

function alreadyHasGate( prop, gateProp ) {
	var count = 0;

	try {
		count = prop.getNumControllers();
	} catch( e1 ) {
		return false;
	}

	for( var i = 0; i < count; i++ ){
		try {
			if( controllerUsesGate( prop.getController( i ), gateProp ) ){
				return true;
			}
		} catch( e2 ) {}
	}

	return false;
}

function addMultiplyGate( prop, gateProp ) {
	if( alreadyHasGate( prop, gateProp ) ){
		return false;
	}

	if( DzERCLink.testCircularLink && DzERCLink.testCircularLink( gateProp, prop ) ){
		throw "Circular ERC link rejected for " + displayName( prop );
	}

	var link = new DzERCLink( DzERCLink.ERCMultiply, gateProp, 1.0, 0.0 );
	link.setSaveWithOutput( true );
	return prop.insertController( link );
}

function summarize( title, lines ) {
	var message = title + "\n\n" + lines.join( "\n" );

	if( MessageBox && MessageBox.information ){
		MessageBox.information( message, "Daz Forge JCM Gate Repair", "&OK" );
	} else {
		print( message );
	}
}

function main() {
	var figure = Scene.getPrimarySelection();

	if( !figure ){
		summarize( "No selected figure.", [
			"Load the character, select the figure in the Scene pane, then run again."
		] );
		return;
	}

	var props = getAllProperties( figure );
	var propCount = getListLength( props );
	var characterMatch = CHARACTER_MATCH;
	var gateProp = null;

	if( characterMatch.length > 0 ){
		gateProp = findGateProperty( props, characterMatch );
	}

	if( !gateProp && AUTO_DETECT_ACTIVE_CHARACTER ){
		gateProp = findActiveCharacterGateProperty( props );
		if( gateProp ){
			characterMatch = deriveMatchTextFromGate( gateProp );
		}
	}

	if( !gateProp ){
		var noGateLines = [
			"Selected item: " + textOf( figure.name ),
			"Character match: " + ( CHARACTER_MATCH.length > 0 ? CHARACTER_MATCH : "<auto>" ),
			"Auto-detect active character: " + AUTO_DETECT_ACTIVE_CHARACTER,
			"Properties scanned: " + propCount,
			"",
			"Manual override hint:",
			"Set CHARACTER_MATCH and JCM_MATCH to the visible character name, for example Beverly or Judith."
		];

		var noGateDiagnostics = collectActiveCharacterDiagnostics( props, MAX_DIAGNOSTIC_LINES );
		if( noGateDiagnostics.length > 0 ){
			noGateLines.push( "" );
			noGateLines.push( "Active character-like properties:" );
			noGateLines = noGateLines.concat( noGateDiagnostics );
		}

		summarize( "No character gate property found.", noGateLines );
		return;
	}

	var jcmMatch = JCM_MATCH.length > 0 ? JCM_MATCH : characterMatch;

	var candidates = [];
	var already = [];
	var changed = [];
	var failed = [];

	for( var i = 0; i < propCount; i++ ){
		var prop = getPropertyAt( props, i );

		if( !isNumericProperty( prop ) || prop == gateProp ){
			continue;
		}

		if( !looksLikeJcmOrCbs( prop, jcmMatch ) ){
			continue;
		}

		if( alreadyHasGate( prop, gateProp ) ){
			already.push( prop );
			continue;
		}

		candidates.push( prop );

		if( APPLY_CHANGES ){
			try {
				if( addMultiplyGate( prop, gateProp ) ){
					changed.push( prop );
				} else {
					failed.push( displayName( prop ) + " - insertController returned false" );
				}
			} catch( err ) {
				failed.push( displayName( prop ) + " - " + textOf( err ) );
			}
		}
	}

	var lines = [];
	lines.push( "Selected item: " + textOf( figure.name ) );
	lines.push( "Gate property: " + displayName( gateProp ) );
	lines.push( "Character match: " + ( CHARACTER_MATCH.length > 0 ? CHARACTER_MATCH : "<auto: " + characterMatch + ">" ) );
	lines.push( "JCM/CBS match: " + ( JCM_MATCH.length > 0 ? JCM_MATCH : "<auto: " + jcmMatch + ">" ) );
	lines.push( "Properties scanned: " + propCount );
	lines.push( "Already gated: " + already.length );
	lines.push( "Needs gate: " + candidates.length );
	lines.push( "Changed: " + changed.length );
	lines.push( "Failed: " + failed.length );
	lines.push( "" );

	if( !APPLY_CHANGES ){
		lines.push( "Preview only is ON. Set APPLY_CHANGES = true at the top of this script to write changes." );
	} else {
		lines.push( "Changes were applied in memory only." );
		lines.push( "Use Save Modified Assets and select only the changed character morph assets." );
	}

	lines.push( "" );
	lines.push( "Candidates:" );

	for( var c = 0; c < candidates.length && c < MAX_PREVIEW_LINES; c++ ){
		lines.push( "  - " + displayName( candidates[c] ) );
	}

	if( candidates.length > MAX_PREVIEW_LINES ){
		lines.push( "  ... " + ( candidates.length - MAX_PREVIEW_LINES ) + " more" );
	}

	if( candidates.length == 0 ){
		var diagnostics = collectActiveCharacterDiagnostics( props, MAX_DIAGNOSTIC_LINES );
		lines.push( "" );
		lines.push( "Manual override hint:" );
		lines.push( "If this picked a generic gate or found no Beverly/Judith JCMs, set CHARACTER_MATCH and JCM_MATCH manually." );

		if( diagnostics.length > 0 ){
			lines.push( "" );
			lines.push( "Active character-like properties:" );
			lines = lines.concat( diagnostics );
		}
	}

	if( failed.length > 0 ){
		lines.push( "" );
		lines.push( "Failures:" );
		for( var f = 0; f < failed.length; f++ ){
			lines.push( "  - " + failed[f] );
		}
	}

	summarize( "JCM Gate Repair complete.", lines );
}

main();
